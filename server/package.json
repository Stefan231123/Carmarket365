{
  "name": "carmarket365-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "ts-node src/main.ts",
    "dev": "nodemon src/main.ts",
    "prebuild": "mkdir -p src/shared && cp ../shared/car-data.ts src/shared/car-data.ts",
    "build": "npm run prebuild && tsc",
    "postinstall": "npm run build",
    "migration:generate": "npx typeorm migration:generate -d src/database/data-source.ts",
    "migration:create": "npx typeorm migration:create",
    "migration:run": "npx typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "npx typeorm migration:revert -d src/database/data-source.ts",
    "migration:show": "npx typeorm migration:show -d src/database/data-source.ts",
    "db:connect": "psql postgresql://postgres:password@localhost:5432/carmarket365",
    "db:backup": "./scripts/backup.sh",
    "db:backup:schema": "./scripts/backup.sh --schema",
    "db:restore": "./scripts/restore.sh",
    "db:restore:list": "./scripts/restore.sh --list",
    "db:validate": "psql $DATABASE_URL -f ./scripts/validate-database.sql",
    "db:seed": "psql $DATABASE_URL -f ./src/database/seeds.sql",
    "db:maintenance": "./scripts/database-maintenance.sh",
    "db:schema": "pg_dump --schema-only $DATABASE_URL > schema.sql",
    "schema:check": "node dist/src/database/check-schema-sync.js",
    "test": "jest --config test/jest-e2e.json --runInBand",
    "test:watch": "jest --config test/jest-e2e.json --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/node": "^10.38.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.18.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.1",
    "typeorm": "^0.3.27",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.2.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
