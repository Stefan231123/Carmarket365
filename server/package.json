{
  "name": "carmarket365-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "dev": "nodemon src/main.ts",
    "build": "tsc",
    "postinstall": "npm run build",
    "db:connect": "psql postgresql://postgres:password@localhost:5432/carmarket365",
    "db:backup": "pg_dump postgresql://postgres:password@localhost:5432/carmarket365 > backup_$(date +%Y%m%d_%H%M).sql",
    "db:validate": "psql postgresql://postgres:password@localhost:5432/carmarket365 -f ./scripts/validate-database.sql",
    "db:seed": "psql postgresql://postgres:password@localhost:5432/carmarket365 -f ./src/database/seeds.sql",
    "db:maintenance": "./scripts/database-maintenance.sh",
    "db:schema": "pg_dump --schema-only postgresql://postgres:password@localhost:5432/carmarket365 > schema.sql"
  },
  "dependencies": {
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.18.2",
    "apollo-server-express": "^3.13.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express-session": "^1.19.0",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.1",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
