# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database_name

# Connection Pool (Optional - sensible defaults applied)
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_IDLE_TIMEOUT=30000
# DB_CONNECT_TIMEOUT=5000

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key

# Server Configuration
PORT=3002
NODE_ENV=production
# LOG_LEVEL=info  # trace, debug, info, warn, error, fatal

# CORS Configuration
CORS_ORIGIN=https://your-frontend-url.vercel.app

# Social Authentication (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Session Configuration
SESSION_SECRET=your-super-secure-session-secret-key

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=CarMarket365 <noreply@carmarket365.com>
CONTACT_EMAIL=your-contact-email@example.com

# Frontend URL (used in email templates)
FRONTEND_URL=https://www.carmarket365.com

# reCAPTCHA v3 (Optional - skipped if not set)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# RECAPTCHA_SCORE_THRESHOLD=0.5

# Sentry Error Monitoring (Optional - skipped if not set)
SENTRY_DSN=https://your-sentry-dsn

# Database Backups (Optional - local backups work without these)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_S3_BUCKET=s3://your-backup-bucket
# BACKUP_S3_REGION=eu-central-1
# BACKUP_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Railway Specific
RAILWAY_STATIC_URL=https://your-app.railway.app