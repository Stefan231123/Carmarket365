# Production Environment Configuration for CarMarket365 Frontend
VITE_APP_NAME=CarMarket365
VITE_APP_ENVIRONMENT=production
VITE_APP_VERSION=1.0.0
VITE_APP_DEBUG=false

# GraphQL API endpoint for Car Market Platform
# Same-site subdomain. The auth cookie is scoped to .carmarket365.com, so it is
# first-party on both www and api and isn't dropped as a third-party cookie.
VITE_GRAPHQL_ENDPOINT=https://api.carmarket365.com/graphql

# Server Configuration
PORT=3002
NODE_ENV=production

# Database Configuration (will be set by hosting provider)
# DB_HOST=your-production-db-host
# DB_PORT=5432
# DB_USERNAME=your-production-db-user
# DB_PASSWORD=your-production-db-password
# DB_NAME=carmarket365_prod

# JWT Secret (will be set by hosting provider)
# JWT_SECRET=your-super-secure-production-jwt-secret

# Application Settings
CORS_ORIGIN=https://carmarket365.com,https://www.carmarket365.com
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Performance Settings
DATABASE_CONNECTION_POOL_SIZE=20
JWT_EXPIRATION=7d

# Security Settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
SESSION_SECURE=true

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-BFE17V5K1W

# Sentry Error Tracking
VITE_SENTRY_DSN=https://6aa21f5c56b76af9cec1400b2f84f1a6@o4510857157804032.ingest.de.sentry.io/4510857167306832

# OAuth (set in Vercel environment variables for production)
VITE_GOOGLE_CLIENT_ID=278873060598-isn3tu53q7l4ron29dc13oi5j545qq9c.apps.googleusercontent.com